// Reaction schemes and process flows without coordinates. `scheme(items)`
// lays items out in a row, all centred on one axis; `step(node, ..)` adds
// captions to a node and `arrow_step(..)` draws an arrow with its conditions
// above / below (a fixed length, "fill" to share the spare width, or the ⇌
// pair). A caption is balanced by an invisible copy on the other side, so
// every node and arrow stays on the axis. `scheme_v` runs down the page.
// The "molecules" are drawn shapes, the icons `labware(..)`; an image works the same
// (`image("compound_a.png").height(1.5)`: its width follows its aspect).
// All names and conditions are fictional.

// A hexagon `2 r` wide (a placeholder structure).
fn ring(r) {
    let pts = [];
    for i in 0..6 {
        let t = (60.0 * i + 30.0) * PI() / 180.0;
        pts.push([r + r * t.cos(), r + r * t.sin()]);
    }
    path(pts).closed().stroke_width(0.04).width(2 * r).height(2 * r)
}

// Lab icons from the framework: line-art glassware of one height
// (`labware_size()`), optionally with liquid.
let flask = labware("flask", #{ level: 0.5 });
let funnel = labware("funnel");
let dish = labware("dish", #{ level: 0.3, liquid: "#d9c7a3" });

page("double", vbox([
    // A reaction: reagents, a conditions arrow, an equilibrium between isomers.
    scheme([
        step(ring(0.6), "Compound A"),
        "+",
        step(ring(0.45), "B"),
        arrow_step(#{ above: "THF, 60 °C", below: "2 h" }),
        step(ring(0.7), #{ above: "major", below: "Product C" }),
        arrow_step(#{ equilibrium: true, above: "hν", below: "Δ" }),
        step(ring(0.7), "Isomer D"),
    ]),
    hsep(0.4),
    // The arrows share the spare width ("fill"): the scheme spans the page.
    scheme([
        step(flask, "Step 1: mix"),
        arrow_step("Solvent X"),
        step(funnel, "Step 2: filter"),
        arrow_step(#{ below: "40 °C, 12 h" }),
        step(dish, "Step 3: dry"),
    ], #{ arrow_length: "fill" }),
    hsep(0.4),
    // Down the page: captions beside the icons, conditions beside the arrows.
    hbox([
        scheme_v([
            step(flask, #{ right: "Dissolve A in THF" }),
            arrow_step("stir, 2 h"),
            step(funnel, #{ right: "Filter" }),
            arrow_step(#{ above: "wash ×3", below: "cold" }),
            step(dish, #{ right: "Dry in vacuo" }),
        ]),
        scheme_v([
            step(ring(0.5), "Compound A"),
            arrow_step(#{ head: "both", above: "exchange" }),
            step(ring(0.5), "Compound B"),
        ]),
    ]),
]))
