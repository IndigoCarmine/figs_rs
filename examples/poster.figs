// Research poster (FES + PMF) — the same content as poster.toml, written with
// the framework: `style("poster")` switches every default to poster scale
// (24 pt body, 60 pt title, 1 cm gaps) in one line, and `captioned` centers
// each caption under its panel.
style("poster");

let muted = "#666666";

page(100, 150,
    col([
        vbox([
            title("Free Energy Surface Analysis"),
            body("MD Simulation Results").color(muted).center(),
        ]),
        // Images take their file's natural aspect; cross "center" keeps each
        // panel at its natural height (rather than stretching it to the row's
        // height) and centers the pair in the free space.
        row([
            captioned(image("fes.png"), "(a) FES 2D Landscape").flex(1),
            captioned(image("pmf.png"), "(b) PMF Profile").flex(1),
        ]).flex(1).spacing(gap() * 1.5).cross("center"),
        body("Simulation: GROMACS 2024, FF: AMBER99SB").size(10).color("#999999").center(),
    ]).spacing(gap() * 2).pad(1.5).stretch(),
).unit("cm").background("#ffffff")
